{
  "name": "localdraw",
  "productName": "Localdraw",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first library of tldraw boards",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.cjs",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "package:mac": "pnpm build && node scripts/package.js",
    "install:mac": "pnpm build && node scripts/package.js --install"
  },
  "devDependencies": {
    "@tldraw/assets": "5.4.2",
    "@tldraw/sync": "5.4.2",
    "@tldraw/sync-core": "5.4.2",
    "@tldraw/tlschema": "5.4.2",
    "@tldraw/validate": "5.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldraw": "5.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
